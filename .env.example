# Только шаблон. Заполните .env локальными значениями; секреты сгенерируйте отдельно.
DATABASE_URL=postgresql://finance:CHANGE_ME@localhost:5432/finance
POSTGRES_USER=finance
POSTGRES_DB=finance
POSTGRES_PASSWORD=CHANGE_ME
BETTER_AUTH_SECRET=CHANGE_ME
BETTER_AUTH_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000
TOKEN_ENCRYPTION_KEY=CHANGE_ME
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=finance@example.invalid
CADDY_HOST=finance.example.invalid
# Технические ограничения; не продуктовые лимиты. В байтах, строках, секундах.
CSV_MAX_BYTES=10485760
CSV_MAX_ROWS=10000
CSV_PREVIEW_TTL_SECONDS=3600
# Отдельная тестовая БД. Никогда не указывать рабочую БД.
TEST_DATABASE_URL=postgresql://finance_test:CHANGE_ME@localhost:5433/finance_test
TEST_POSTGRES_PASSWORD=CHANGE_ME
# Серверные сроки и лимиты авторизации (секунды).
AUTH_INVITE_TTL_SECONDS=604800
AUTH_RESET_TTL_SECONDS=3600
AUTH_LOGIN_LIMIT=5
AUTH_WINDOW_SECONDS=900
AUTH_RESET_EMAIL_LIMIT=3
AUTH_RESET_IP_LIMIT=10
AUTH_INVITE_OWNER_LIMIT=10
AUTH_INVITE_WINDOW_SECONDS=3600
AUTH_INVITE_RECIPIENT_SECONDS=60
# В локальном dev false; production Compose использует доверенный Caddy.
TRUST_PROXY=false
TRUSTED_PROXY_SECRET=CHANGE_ME
